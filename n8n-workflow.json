        "jsCode": "const body = $input.first().json.body;\n\nconst sessionId = body.sessionId;\nconst streak = body.streak;\nconst coins = body.coins;\n\n// Deduplication check using static storage\nif (!$workflow.staticData.processedSessions) {\n  $workflow.staticData.processedSessions = {};\n}\n\nif ($workflow.staticData.processedSessions[sessionId]) {\n  return [{ json: { skipped: true, reason: 'already processed', sessionId } }];\n}\n\n// Mark as processed\n$workflow.staticData.processedSessions[sessionId] = true;\n\nreturn [{\n  json: {\n    skipped: false,\n    sessionId,\n    message: `Streak now ${streak} days, +50 coins. Total coins: ${coins}`,\n    studentId: body.studentId,\n    minutesFocused: body.minutesFocused,\n  }\n}];"
      },
